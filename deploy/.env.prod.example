# ============================================================================
# 随口说 — 云服务器 prod .env 模板
# ----------------------------------------------------------------------------
# 用法：scp 到云服务器 sks-agent 仓根，改名为 .env（gitignored，不入 git），
#       chmod 600 .env。填实 <...> 占位，把「复制自本地 .env」的 key 贴过来。
# 分类：① 复制自本地 .env（同一套付费 API key）/ ② 生成新强值 / ③ 填 prod 专值
# ============================================================================

# ── 镜像仓库（compose 插值，三服务从这里 pull）────────────────────────────────
# ③ 个人版 ACR（北京）。本机 acr-sync.sh 走公网 push；ECS 用下面 VPC 地址 pull。
#    登录用户名 dingtalk_bakexx，密码在控制台「访问凭证」。本地联调不设此项，默认 GHCR。
SKS_IMAGE_REGISTRY=crpi-7eu3mopdi4xg4ext-vpc.cn-beijing.personal.cr.aliyuncs.com/suikoushuo

# ── 数据库 ────────────────────────────────────────────────────────────────────
POSTGRES_DB=sks
POSTGRES_USER=sks
# ② 生成强密码（prod 新起 pg 卷，不复用本地）。pg_backup/restore 走这个密码
POSTGRES_PASSWORD=<生成强密码>

# ── JWT 双密钥（C 端 / 管理端 aud 隔离，必须不同）─────────────────────────────
# ② 各生成 ≥32 字节随机；占位值 change_me_* 会被 JwtConfig.guardSecret 启动即抛
JWT_SECRET_USER=<生成 ≥32 字节随机>
JWT_SECRET_ADMIN=<生成 ≥32 字节随机，与 USER 不同>

# ── 内网服务令牌（Java↔Python 共享，防内网伪造）──────────────────────────────
# ② 生成强随机
SERVICE_TOKEN=<生成强随机>

# ── 管理端种子账号（AdminSeedRunner 哈希后写 admin_user）──────────────────────
ADMIN_SEED_USERNAME=admin
# ② 生成强密码（站长登录）
ADMIN_SEED_PASSWORD=<生成强密码>

# ── 注册体验额度 ───────────────────────────────────────────────────────────────
TRIAL_CREDIT=3

# ── AI / 数据源 key（① 复制自本地 .env，同一套付费 key）────────────────────────
ZHIPU_API_KEY=<复制自本地>            # 智谱 GLM：script_gen/attribution/interview/card_gen
TIKHUB_API_KEY=<复制自本地>           # TikHub：precheck/hot_board/拆账号；api.tikhub.dev 须可达
ALIYUN_ACCESS_KEY_ID=<复制自本地>     # 阿里云主 AK：内容安全 + 短信 + 余额查询
ALIYUN_ACCESS_KEY_SECRET=<复制自本地> # 阿里云 SK
# ③ 拆视频/拆账号的 Qwen 长转写 + 短 ASR（DashScope/百炼 key，与主 AK 不同）
#    本地 .env 多半缺这项；prod 必填，否则长转写失败
ALIYUN_ASR_KEY=<填百炼/DashScope key>

# ── 短信（DYPNS）──────────────────────────────────────────────────────────────
# ⚠️ 别在这里加 ALIYUN_SMS_SIGN / _ENDPOINT / _TEMPLATE_* 三行！
#    签名/端点/三个模板号已写死在 sks-server application.yml 的 sks.sms.*（非 ASCII
#    签名经 .env 会被按 ISO-8859-1 读成乱码；留一行空 XXX= 会用空值覆盖 yml 的
#    ${VAR:默认值} → 短信静默退回 stub，不发也不报错）。
#    短信闸门 = 上面 ALIYUN_ACCESS_KEY_ID/SECRET：配了真发，未配只落库。

# ── 邮件告警（先不做）──────────────────────────────────────────────────────────
# 可整段省略。MailAlertNotifier 在 host 空时不发。
# SPRING_MAIL_HOST=
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SKS_ALERT_ADMIN_EMAIL=

# ── 可选（一般不设，用默认）──────────────────────────────────────────────────
# ASR_TMP_DIR=/data/sks-asr-tmp   # sks-ai 媒体下载/转码临时目录；空→系统 tempfile
#   生产建议挂卷并监控磁盘；长转写产物会占空间
# 以下均有默认，除非要改否则别设：
#   ZHIPU_BASE_URL / TIKHUB_BASE_URL(主域名被墙，须默认 https://api.tikhub.dev)
#   ALIYUN_CONTENT_SAFETY_ENDPOINT / SKS_AI_BASE_URL(http://sks-ai:8000)
#   SKS_AI_READ_TIMEOUT(勿低于270，否则 §5.3 超时链断裂) / SKS_AI_CONNECT_TIMEOUT
#   sks.review.hot-threshold/flop-threshold(3.0/0.5) / sks.quota.sms-threshold/glm-threshold(100/¥20)
# deprecated：ALIYUN_ASR_APP_KEY（长转写已切 Qwen，sks-ai 不再读，可留空）
