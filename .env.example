POSTGRES_DB=sks
POSTGRES_USER=sks
POSTGRES_PASSWORD=change_me
# JWT：change_me_... 占位值会被 JwtConfig.guardSecret 启动即抛，必须换 ≥32 字节真值
JWT_SECRET_USER=change_me_user_secret_min_32_bytes
JWT_SECRET_ADMIN=change_me_admin_secret_min_32_bytes
SERVICE_TOKEN=change_me_internal_shared_token
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change_me_admin_login_pwd
TRIAL_CREDIT=3
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# DYPNS 短信：签名 / 端点 / 三个模板号都【不是 env 键】，已写死在 sks-server 的 application.yml
# （sks.sms.*）——它们不是密钥。上面 AK 两项是短信的唯一配置，也是「真发 or stub」的唯一闸门。
# 别往这里加回 ALIYUN_SMS_SIGN / ALIYUN_SMS_TEMPLATE_*：签名是非 ASCII，经 .env 会被 properties
# 加载器按 ISO-8859-1 读成乱码，阿里云只回「签名或者模版无效」、不提编码；模板号即便留一行空的
# XXX= 也会覆盖掉 application.yml 的值（${VAR:默认值} 对「已定义但为空」用空值）→ 静默退回 stub。
# Python ASR：短 ASR + 长转写（qwen3-asr-flash）共用 DashScope/百炼 Key（sks-ai 镜像须含 ffmpeg + nodejs）
ALIYUN_ASR_KEY=
# deprecated：长转写已改 Qwen，可留空（兼容旧 .env）
ALIYUN_ASR_APP_KEY=
ZHIPU_API_KEY=
TIKHUB_API_KEY=
# 邮件告警：host/收件人空走 stub 静默不发
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SKS_ALERT_ADMIN_EMAIL=
# SPRING_MAIL_PORT 有默认 465（ssl.enable=true 已钉 yaml 不走 env）
# ZHIPU_BASE_URL / TIKHUB_BASE_URL / ALIYUN_CONTENT_SAFETY_ENDPOINT 有默认，一般不改
