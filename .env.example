POSTGRES_DB=sks
POSTGRES_USER=sks
POSTGRES_PASSWORD=change_me
# JWT：change_me_... 占位值会被 JwtConfig.guardSecret 启动即抛，必须换 ≥32 字节真值
JWT_SECRET_USER=change_me_user_secret_min_32_bytes
JWT_SECRET_ADMIN=change_me_admin_secret_min_32_bytes
SERVICE_TOKEN=change_me_internal_shared_token
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change_me_admin_login_pwd
TRIAL_CREDIT=3
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# DYPNS 短信：签名 / 端点 / 三个模板号都【不是 env 键】，已写死在 sks-server 的 application.yml
# （sks.sms.*）。上面 AK 两项是唯一闸门：配了就真发，未配则只落库（本地/CI）。
# 别往这里加回 ALIYUN_SMS_SIGN / ALIYUN_SMS_TEMPLATE_*：签名经 .env 会乱码；模板号空行会覆盖 yml。
# Python ASR：短 ASR + 长转写（qwen3-asr-flash）共用 DashScope/百炼 Key（sks-ai 镜像须含 ffmpeg + nodejs）
ALIYUN_ASR_KEY=
# deprecated：长转写已改 Qwen，可留空（兼容旧 .env）
ALIYUN_ASR_APP_KEY=
ZHIPU_API_KEY=
TIKHUB_API_KEY=
# 告警邮件先不做，以下可省略
# SPRING_MAIL_HOST=
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SKS_ALERT_ADMIN_EMAIL=
# 生产 ECS 用 ACR VPC：SKS_IMAGE_REGISTRY=crpi-7eu3mopdi4xg4ext-vpc.cn-beijing.personal.cr.aliyuncs.com/suikoushuo
# 本地不设则 compose 默认 ghcr.io/wangbuer1984
# ZHIPU_BASE_URL / TIKHUB_BASE_URL / ALIYUN_CONTENT_SAFETY_ENDPOINT 有默认，一般不改
